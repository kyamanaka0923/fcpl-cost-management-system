# エディタ・dotnet format 共通の書式設定。
# フロントエンド(TS/TSX/CSS)の書式は Prettier(frontend/.prettierrc.json)が決める。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.md]
# Markdown の行末スペース2つは改行の意味を持つため削らない
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# C# のコードスタイル(エディタの提案。ビルドは止めない)
# ---------------------------------------------------------------------------
[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_new_line_before_open_brace = methods, properties, accessors, control_blocks, types, lambdas, local_functions
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# ---------------------------------------------------------------------------
# .NET アナライザ(backend/Directory.Build.props で AnalysisLevel=latest-recommended)
# このプロジェクトの方針と合わないルールだけ、理由を添えて無効化する。
# ---------------------------------------------------------------------------

# ドメインサービスはステートレスだが、DI で注入して差し替え可能にするためインスタンスメソッドにしている
dotnet_diagnostic.CA1822.severity = none
# 名前空間 "Shared" は VB の予約語と衝突するという警告。C# のみのプロジェクトなので対象外
dotnet_diagnostic.CA1716.severity = none

[tests/**.cs]
# テスト名は日本語の文で、区切りに "_" を使うことがある
dotnet_diagnostic.CA1707.severity = none
# xUnit のテストクラスの Dispose は一時 DB の後始末だけで、ファイナライザを持つ派生型は作らない
dotnet_diagnostic.CA1816.severity = none
