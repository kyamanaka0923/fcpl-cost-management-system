{
  "name": "cost-management-frontend-unit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "フロントエンド単独テスト(Vitest + Testing Library + MSW)。frontend/src の画面とロジックを、ブラウザもバックエンドも使わずに確かめる。",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
