{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready)",
      "Bash(gh pr ready *)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Write(requirements/screens/approved/**)",
      "Edit(requirements/screens/approved/**)",
      "Write(.factory/approvals/**)",
      "Edit(.factory/approvals/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  }
}
