<Project>
  <!-- すべてのバックエンドプロジェクトに共通のビルド設定。 -->
  <PropertyGroup>
    <!-- .NET アナライザの推奨ルールを有効にする(方針に合わないルールはリポジトリ直下の .editorconfig で調整) -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- 警告はエラーとして扱い、新しい警告を持ち込まない -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 依存パッケージの脆弱性通知(NuGet Audit)はビルドを止めず、警告として気づけるようにする -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
